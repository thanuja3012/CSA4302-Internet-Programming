* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #eef8f3;
  --bg-soft: #f8fbfa;
  --text: #173b35;
  --text-soft: #56736f;
  --text-muted: #758b86;
  --primary: #0d9a75;
  --primary-dark: #087351;
  --primary-light: #d6f7e9;
  --primary-deep: #123b34;
  --text-on-primary: #ecfff8;
  --secondary: #215b53;
  --attention: #f4b742;
  --danger: #c94b4b;
  --line: #cde8df;
  --card: #ffffff;
  --panel: #fbfffd;
  --shadow: rgba(30, 71, 61, 0.10);
  --shadow-strong: rgba(30, 75, 67, 0.24);
  --danger-light: #ffe8e8;
  --success-light: #d9f6e8;
  --blue-soft: #dcecf3;
}

body {
  font-family: "Segoe UI", Arial, sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at 70% 8%, rgba(203, 251, 227, 0.5), transparent 26%),
    radial-gradient(circle at 92% 16%, rgba(205, 232, 223, 0.8), transparent 16%),
    var(--bg);
  line-height: 1.6;
}

body::before {
  content: "";
  position: fixed;
  inset: -30%;
  background-image:
    radial-gradient(#a5d8cd 1px, transparent 1px),
    radial-gradient(#c4ece7 1px, transparent 1px);
  background-position: 0 0, 20px 20px;
  background-size: 80px 80px, 80px 80px;
  opacity: 0.16;
  pointer-events: none;
  z-index: -1;
}

.container {
  width: min(1280px, calc(100% - 96px));
  margin: auto;
}

.topbar {
  background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(241,251,248,0.96));
  border-bottom: 1px solid rgba(146, 197, 180, 0.34);
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(12px);
}

.nav-wrapper {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-icon {
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: var(--primary-deep);
  color: white;
  border: 1px solid rgba(255,255,255,0.38);
}

.brand-icon svg {
  width: 28px;
  height: 28px;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linejoin: round;
  stroke-linecap: round;
  fill: none;
}

.brand-text {
  font-size: 29px;
  font-weight: 800;
  color: var(--primary-deep);
  letter-spacing: -1px;
}

.main-nav {
  display: flex;
  gap: 34px;
}

.main-nav a {
  position: relative;
  text-decoration: none;
  font-weight: 700;
  font-size: 14px;
  color: var(--text-soft);
}

.main-nav a.active,
.main-nav a:hover {
  color: var(--primary-dark);
}

.main-nav a.active::after,
.main-nav a:hover::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -9px;
  height: 3px;
  border-radius: 99px;
  background: var(--primary);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.link-button {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-soft);
  text-decoration: none;
}

.link-button.muted {
  color: var(--text-muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 24px;
  border-radius: 13px;
  border: none;
  font-weight: 800;
  font-size: 13px;
  text-decoration: none;
  cursor: pointer;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  background: var(--primary);
  color: white;
  box-shadow: 0 11px 28px rgba(20, 150, 108, 0.22);
}

.btn-primary:hover {
  background: var(--primary-dark);
}

.btn-ghost {
  background: #edf8f5;
  color: var(--secondary);
  border: 1px solid #bdebdc;
}

.btn-secondary {
  background: var(--primary-deep);
  color: white;
}

.btn-outline {
  border: 1px solid var(--primary);
  background: transparent;
  color: var(--primary-deep);
}

.btn-large {
  padding: 14px 28px;
  font-size: 14px;
}

.btn-block {
  width: 100%;
}

.hero-section {
  padding-top: 64px;
  padding-bottom: 50px;
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(620px, 1.1fr) minmax(420px, 440px);
  gap: 58px;
  align-items: center;
}

.hero-copy {
  padding-top: 20px;
}

.kicker {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  font-size: 13px;
  color: var(--primary-dark);
  letter-spacing: 1.4px;
  text-transform: uppercase;
}

.pulse-dot {
  width: 11px;
  height: 11px;
  border-radius: 999px;
  display: inline-block;
  background: var(--primary);
  border: 2px solid white;
  box-shadow: 0 0 0 0 rgba(13,154,117,0.45);
  animation: pulse 2s infinite;
}

.hero-copy h1 {
  margin-top: 16px;
  font-size: clamp(46px, 5.2vw, 82px);
  line-height: 0.94;
  letter-spacing: -4px;
  color: var(--primary-deep);
}

.hero-text {
  margin-top: 26px;
  font-size: 18px;
  line-height: 1.82;
  color: var(--text-soft);
  max-width: 720px;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 38px;
}

.hero-stats {
  margin-top: 62px;
  display: flex;
  gap: 60px;
}

.hero-stats article {
  min-width: 150px;
}

.stat-number {
  display: block;
  font-size: 34px;
  line-height: 1;
  font-weight: 900;
  color: var(--primary-deep);
}

.stat-label {
  margin-top: 9px;
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
}

.glass-panel {
  background: linear-gradient(145deg, #ffffff, #eefdf7);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 28px;
  box-shadow: 0 30px 90px var(--shadow);
  position: relative;
  overflow: hidden;
}

.glass-panel::before {
  content: "";
  position: absolute;
  width: 210px;
  height: 210px;
  border-radius: 50%;
  border: 1px solid var(--line);
  right: -68px;
  top: -56px;
}

.glass-panel::after {
  content: "";
  position: absolute;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  border: 1px solid var(--primary);
  left: -24px;
  bottom: -24px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.panel-header h2,
.panel-header h3 {
  margin-top: 6px;
  font-size: 26px;
  color: var(--primary-deep);
}

.panel-header h2 {
  font-size: 28px;
}

.small-label {
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-muted);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 7px 12px;
  border-radius: 99px;
  font-size: 11px;
  font-weight: 900;
}

.status-badge.success {
  background: var(--success-light);
  color: var(--primary-dark);
}

.status-badge.warning {
  background: #fff5dd;
  color: #ae6d00;
}

.status-badge.info {
  background: var(--blue-soft);
  color: #245f69;
}

.login-form {
  position: relative;
}

.login-form .field-label {
  display: block;
  margin-bottom: 8px;
  margin-top: 16px;
  color: var(--text-soft);
  font-size: 12px;
  font-weight: 800;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: white;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 8px 12px;
}

.input-wrap:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(13,154,117,0.14);
}

.input-wrap input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  padding: 11px 10px;
  font-size: 14px;
  color: var(--text);
}

.icon-wrap {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
}

.icon-wrap svg {
  width: 21px;
  height: 21px;
  stroke: var(--primary-dark);
  stroke-width: 1.5;
  stroke-linejoin: round;
  stroke-linecap: round;
  fill: none;
}

.verify-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14px;
  margin-bottom: 18px;
}

.text-link {
  color: var(--primary-dark);
  font-size: 12px;
  font-weight: 800;
}

.security-note {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 22px;
  font-size: 12px;
  color: var(--text-muted);
}

.lock-icon {
  font-size: 22px;
}

.overview {
  padding-bottom: 46px;
}

.section-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(160px, 1fr));
  gap: 24px;
}

.metric-card {
  background: var(--card);
  border-radius: 20px;
  border: 1px solid var(--line);
  padding: 24px;
  box-shadow: 0 10px 28px var(--shadow);
}

.highlight-card {
  background: linear-gradient(120deg, var(--primary-deep), #196b53);
  color: white;
  border: none;
}

.metric-card h3 {
  margin-top: 24px;
  font-size: 20px;
}

.highlight-card h3 {
  color: white;
}

.metric-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.metric-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--primary-light);
  display: grid;
  place-items: center;
}

.metric-icon svg {
  width: 21px;
  height: 21px;
  stroke: var(--primary-deep);
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  fill: none;
}

.highlight-card .metric-icon {
  background: rgba(255,255,255,0.14);
  color: white;
}

.highlight-card .metric-icon svg {
  stroke: white;
}

.trend {
  font-size: 12px;
  font-weight: 900;
  padding: 5px 10px;
  border-radius: 99px;
  background: var(--success-light);
  color: var(--primary-dark);
}

.trend.positive {
  background: var(--success-light);
  color: var(--primary-dark);
}

.trend.neutral {
  background: #eef6ff;
  color: #335484;
}

.highlight-card .trend {
  background: rgba(255,255,255,0.12);
  color: white;
}

.metric-value {
  margin-top: 16px;
  font-size: 24px;
  font-weight: 900;
}

.highlight-card .metric-value {
  color: white;
}

.small-detail,
.metric-card .small-detail {
  margin-top: 10px;
  font-size: 11px;
  color: var(--text-muted);
}

.highlight-card .small-detail {
  color: rgba(255,255,255,0.85);
}

.progress-block {
  margin-top: 26px;
}

.bar-shell {
  height: 10px;
  border-radius: 99px;
  background: rgba(255,255,255,0.18);
  border: 1px solid rgba(255,255,255,0.35);
  overflow: hidden;
}

.highlight-card .bar-shell {
  background: rgba(255,255,255,0.16);
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #eaff73, #58ddaa);
  border-radius: 99px;
}

.bar-caption {
  margin-top: 9px;
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: white;
}

.content-sections {
  padding-bottom: 46px;
}

.content-grid {
  display: grid;
  grid-template-columns: minmax(690px, 2fr) minmax(300px, 1fr);
  gap: 30px;
}

.panel {
  background: var(--panel);
  border-radius: 24px;
  border: 1px solid var(--line);
  padding: 26px;
  box-shadow: 0 14px 50px var(--shadow);
}

.main-panel {
  min-height: 390px;
}

.compact-header {
  align-items: flex-start;
}

.compact-header h2 {
  letter-spacing: -1px;
}

.voting-layout {
  display: grid;
  grid-template-columns: minmax(210px, 0.8fr) minmax(440px, 1.6fr);
  gap: 26px;
  align-items: stretch;
}

.voter-card {
  padding: 24px;
  background: linear-gradient(180deg, #ebfbf5, #ffffff);
  border-radius: 20px;
  border: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100%;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 16px;
}

.avatar-ring {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  border: 4px solid var(--primary-light);
  display: grid;
  place-items: center;
}

.avatar {
  width: 72px;
  height: 72px;
  background: var(--primary-deep);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: white;
  font-size: 20px;
  font-weight: 900;
}

.profile-card h4 {
  font-size: 24px;
  margin-top: 4px;
}

.label-text {
  font-size: 11px;
  color: var(--text-muted);
  font-weight: 900;
  text-transform: uppercase;
}

.muted-text {
  margin-top: 4px;
  font-size: 12px;
  color: var(--text-muted);
}

.vote-status-grid {
  margin-top: 30px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--line);
  padding-top: 20px;
}

.mini-label {
  display: block;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-muted);
}

.ok-text {
  display: inline-block;
  margin-top: 6px;
  font-size: 15px;
  font-weight: 800;
  color: var(--primary-dark);
}

.vote-card {
  padding: 4px 10px;
}

.vote-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.vote-card-header h3 {
  margin-top: 4px;
  font-size: 24px;
  color: var(--primary-deep);
}

.round-step {
  display: inline-flex;
  align-items: center;
  padding: 8px 14px;
  border-radius: 99px;
  background: var(--primary-light);
  color: var(--primary-dark);
  font-size: 11px;
  font-weight: 900;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.candidate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-radius: 16px;
  border: 1px solid var(--line);
  background: white;
}

.candidate-row.selected {
  border-color: var(--primary);
  box-shadow: inset 0 0 0 2px rgba(13,154,117,0.1);
}

.candidate-info {
  display: flex;
  align-items: center;
  gap: 13px;
}

.candidate-info h4 {
  font-size: 18px;
  color: var(--primary-deep);
}

.candidate-info p {
  font-size: 12px;
  color: var(--text-muted);
}

.candidate-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary-deep);
  display: grid;
  place-items: center;
  font-weight: 900;
  border: 2px solid white;
}

.candidate-avatar.alt {
  background: #f7f1dd;
  color: #a66a13;
}

.candidate-avatar.blue {
  background: #dde9f3;
  color: #17476e;
}

.tag {
  margin-top: 6px;
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 99px;
  background: #effcf6;
  font-size: 10px;
  color: var(--primary-dark);
}

.radio-box {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid var(--line);
  display: grid;
  place-items: center;
  cursor: pointer;
}

.radio-box span {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: transparent;
}

.radio-box input {
  position: absolute;
  opacity: 0;
}

.radio-box input:checked + span {
  background: var(--primary);
}

.candidate-row.selected .radio-box {
  border-color: var(--primary);
}

.vote-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 26px;
}

.right-panel {
  background: linear-gradient(180deg, #eefbf6, #fbfffd);
}

.icon-button {
  display: inline-flex;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid var(--line);
  place-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-weight: 900;
}

.result-summary {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.result-head {
  display: flex;
  align-items: center;
  gap: 16px;
}

.round-orb {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 8px solid var(--primary-light);
  display: grid;
  place-items: center;
}

.round-orb span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
}

.big-number {
  color: var(--primary-deep);
  font-size: 44px;
  font-weight: 900;
  line-height: 1;
}

.chart-card {
  padding: 18px;
  background: white;
  border-radius: 16px;
  border: 1px solid var(--line);
}

.chart-chart {
  height: 180px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
}

.chart-bar {
  flex: 1;
  min-height: 20px;
  border-radius: 8px 8px 2px 2px;
  background: linear-gradient(180deg, var(--primary), var(--primary-dark));
}

.bar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 18px;
  font-size: 11px;
  color: var(--text-muted);
}

.legend-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 6px;
}

.legend-dot.one { background: var(--primary); }
.legend-dot.two { background: #eeb22e; }
.legend-dot.three { background: #6072b9; }

.admin-section {
  padding-bottom: 46px;
}

.two-column {
  display: grid;
  grid-template-columns: minmax(660px, 2fr) minmax(350px, 1fr);
  gap: 30px;
}

.admin-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(230px, 1fr));
  gap: 16px;
}

.admin-task {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 16px;
  border-radius: 16px;
  background: #fafffd;
  border: 1px solid var(--line);
}

.admin-task h4 {
  font-size: 16px;
  color: var(--primary-deep);
}

.admin-task p {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 6px;
}

.admin-icon {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: var(--primary-light);
  display: grid;
  place-items: center;
}

.admin-icon svg {
  width: 22px;
  height: 22px;
  stroke: var(--primary-dark);
  stroke-width: 1.6;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.election-status {
  background: #eefdfb;
}

.timeline {
  margin-top: 20px;
}

.timeline-step {
  display: flex;
  gap: 14px;
  border-left: 2px solid var(--line);
  padding: 14px 0 14px 26px;
  position: relative;
}

.timeline-step:last-child {
  border-left-color: transparent;
}

.timeline-step .timeline-dot {
  position: absolute;
  width: 12px;
  height: 12px;
  left: -7px;
  top: 20px;
  border-radius: 50%;
  border: 2px solid white;
  background: var(--line);
}

.timeline-step.done .timeline-dot {
  background: var(--primary);
}

.timeline-step.current .timeline-dot {
  background: var(--attention);
}

.timeline-step h4 {
  font-size: 16px;
  color: var(--primary-deep);
}

.timeline-step p {
  font-size: 12px;
  color: var(--text-muted);
}

.time-label {
  display: inline-flex;
  margin-bottom: 4px;
  font-size: 10px;
  color: var(--text-muted);
  letter-spacing: 2px;
  font-weight: 900;
}

.cta-section {
  background: linear-gradient(120deg, var(--primary-deep), #0d453b);
  padding: 54px 0;
}

.cta-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cta-grid h2 {
  color: white;
  font-size: 34px;
  margin-top: 8px;
}

.cta-grid p {
  max-width: 690px;
  color: rgba(255,255,255,0.88);
  margin-top: 12px;
}

.cta-grid .small-label {
  color: #bdebdc;
}

.cta-actions {
  display: flex;
  gap: 14px;
}

.cta-actions .btn-outline {
  color: white;
  background: rgba(255,255,255,0.05);
  border-color: rgba(255,255,255,0.5);
}

.cta-actions .btn-primary {
  background: white;
  color: var(--primary-deep);
}

.footer {
  background: #173b35;
  padding: 28px 0;
}

.footer-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer .brand-text {
  color: white;
}

.footer-brand .brand-icon {
  background: var(--primary);
}

.footer-links {
  display: flex;
  gap: 26px;
}

.footer-links a {
  color: rgba(255,255,255,0.88);
  text-decoration: none;
  font-size: 12px;
}

.copyright {
  color: rgba(255,255,255,0.64);
  font-size: 12px;
}

@keyframes pulse {
  70% {
    box-shadow: 0 0 0 11px transparent;
  }
}

@media (max-width: 1050px) {
  .container {
    width: min(1280px, calc(100% - 48px));
  }

  .hero-grid,
  .content-grid,
  .two-column,
  .voting-layout {
    grid-template-columns: 1fr;
  }

  .hero-copy h1 {
    font-size: clamp(42px, 8vw, 70px);
  }

  .section-grid {
    grid-template-columns: repeat(2, minmax(220px, 1fr));
  }

  .cta-grid {
    align-items: flex-start;
    flex-direction: column;
    gap: 30px;
  }
}

@media (max-width: 720px) {
  .nav-wrapper {
    flex-wrap: wrap;
    padding: 14px 0;
  }

  .main-nav {
    order: 2;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    gap: 26px;
  }

  .nav-actions {
    width: 100%;
    justify-content: center;
  }

  .hero-section {
    padding-top: 42px;
  }

  .hero-text {
    font-size: 17px;
  }

  .hero-stats {
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 40px;
  }

  .section-grid,
  .admin-grid {
    grid-template-columns: 1fr;
  }

  .panel,
  .glass-panel {
    padding: 20px;
  }

  .footer-content,
  .footer-links {
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .hero-actions,
  .vote-actions,
  .cta-actions {
    width: 100%;
    flex-direction: column;
  }

  .hero-actions .btn,
  .vote-actions .btn,
  .cta-actions .btn {
    width: 100%;
  }
}
