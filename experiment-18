<script>


let cart=[];

let balance=2000;

let otpCode="123456";


function loginUser(){

alert(
"Login Successful\n"+
"OTP verification required."
);

}


function sendOTP(){

document.getElementById("otpMessage").innerHTML=
"Demo OTP sent: <b>123456</b>";

}


function verifyOTP(){

let otp=
document.getElementById("otp").value;

if(otp==otpCode){

document.getElementById("otpMessage").innerHTML=
"<b>OTP Verified Successfully</b>";

}

else{

document.getElementById("otpMessage").innerHTML=
"<b>Invalid OTP</b>";

}

}


function searchProduct(){

let value=
document.getElementById("search").value.toLowerCase();

if(value.includes("rice")){

document.getElementById("searchResult").innerHTML=
"<b>Product Found:</b> Rice Seeds - ₹500";

}

else if(value.includes("fertilizer")){

document.getElementById("searchResult").innerHTML=
"<b>Product Found:</b> Organic Fertilizer - ₹800";

}

else if(value.includes("pesticide")){

document.getElementById("searchResult").innerHTML=
"<b>Product Found:</b> Crop Pesticide - ₹650";

}

else{

document.getElementById("searchResult").innerHTML=
"<b>No Product Found</b>";

}

}


function addCart(name,price){

cart.push({
name:name,
price:price
});

displayCart();

alert(name+" added to cart");

}


function displayCart(){

let table=
document.getElementById("cartTable");

table.innerHTML=
`
<tr>
<th>Product</th>
<th>Price</th>
<th>Quantity</th>
<th>Action</th>
</tr>
`;

let total=0;

cart.forEach((item,index)=>{

total+=item.price;

table.innerHTML+=
`
<tr>
<td>${item.name}</td>
<td>₹${item.price}</td>
<td>1</td>
<td>
<button onclick="deleteCart(${index})">
Delete
</button>
</td>
</tr>
`;

});

document.getElementById("total").innerHTML=
"Total: ₹"+total;

}


function deleteCart(index){

cart.splice(index,1);

displayCart();

}


function checkout(){

if(cart.length==0){

alert("Cart is empty");

return;

}

let total=0;

cart.forEach(item=>{
total+=item.price;
});

if(balance>=total){

balance-=total;

document.getElementById("walletBalance").innerHTML=
"Wallet Balance: ₹"+balance;

alert(
"Order Placed Successfully\n"+
"Amount Paid: ₹"+total
);

cart=[];

displayCart();

}

else{

alert("Insufficient wallet balance");

}

}


function addMoney(){

let amount=
Number(document.getElementById("money").value);

if(amount>0){

balance+=amount;

document.getElementById("walletBalance").innerHTML=
"Wallet Balance: ₹"+balance;

alert("Money Added Successfully");

}

else{

alert("Enter a valid amount");

}

}

</script>


